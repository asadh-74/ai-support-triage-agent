# Copy this file to .env and fill it in. NEVER commit .env to GitHub.

# Free token: https://huggingface.co/settings/tokens  (create a "Read" token, or a fine-grained one
# with permission to call Inference Providers). Leave empty to run in keyword-only demo mode.
HF_TOKEN=

# Models (any chat model available to you on Hugging Face Inference Providers works)
HF_LLM_MODEL=Qwen/Qwen2.5-7B-Instruct
HF_EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Protects POST /api/triage. n8n must send this in the X-API-Key header. Leave empty to disable (local only!).
API_KEY=change-me-to-a-long-random-string

# Agent behaviour
CONFIDENCE_THRESHOLD=0.7
MAX_AGENT_STEPS=4
DEMO_RATE_LIMIT_PER_MIN=8

# --- Company persona (the demo prompts are written for "ShopNova") ---
COMPANY_NAME=ShopNova

# --- Firecrawl: keep the knowledge base in sync with your live website ---
# Free key: https://www.firecrawl.dev  (each scraped page costs about 1 credit)
FIRECRAWL_API_KEY=
# Comma-separated pages to scrape. Only scrape sites you own or are allowed to scrape.
KB_SOURCE_URLS=
# 1 = scrape exactly these pages. Higher = also crawl linked pages, up to this many per URL.
KB_CRAWL_LIMIT=1
# Render's free disk resets on restart, so set true there to re-scrape on every boot.
KB_SYNC_ON_STARTUP=false
